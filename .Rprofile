source("renv/activate.R")

# Use Posit Public Package Manager as the CRAN mirror, via its SOURCE url.
# renv transforms this into a platform-appropriate binary URL where supported
# (e.g. Ubuntu in CI) and transparently falls back to source builds elsewhere.
# Recorded into renv.lock at snapshot time.
options(repos = c(CRAN = "https://packagemanager.posit.co/cran/latest"))

