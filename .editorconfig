# EditorConfig: consistent formatting across VSCode, RStudio, Neovim, and
# every other editor that honors it (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{R,r,Rmd,qmd,md}]
indent_style = space
indent_size = 2

[*.{yml,yaml,toml,json}]
indent_style = space
indent_size = 2

[*.{c,h,cpp,hpp}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.dcf]
indent_style = space
indent_size = 2
